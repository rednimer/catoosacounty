---
/**
 * Homepage.
 *
 * Order is deliberate and follows what converted on the Cañon City build:
 * hero → the two products → sizes with prices → why here → location → FAQ → CTA.
 *
 * The one structural difference: climate control leads. It is the only thing this
 * facility publicly differentiates on, it is what the directory listings put in the
 * business name, and North Georgia humidity makes it an easy argument to win.
 *
 * Photography arrived from the owner 2026-08-09. It is web-sized rather than
 * camera originals, so every photo here is rendered inside a constrained column
 * and never full-bleed — see the resolution note in src/data/images.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import Figure from '../components/Figure.astro';
import { SITE, CONTACT, ADDRESS, HOURS, FEATURES, SERVICE_AREA } from '../data/site';
import { UNITS, CATALOGUE_PROVISIONAL, PRICING_AVAILABLE } from '../data/units';
import { IMAGES } from '../data/images';

const faqs = [
  {
    question: 'Where is Catoosa County Storage?',
    answer: `We are at ${ADDRESS.formatted}. ${ADDRESS.accessNote}`,
  },
  {
    question: 'What is the difference between climate-controlled and drive-up units?',
    answer:
      'Climate-controlled units are temperature and humidity controlled, which protects furniture, electronics, photographs and paperwork through a Georgia summer. Drive-up units let you pull your vehicle right to the door, which makes loading and unloading much faster. We have both on the same property.',
  },
  {
    question: 'How much does a unit cost?',
    answer: `Rates depend on the size and whether you want climate control. Call ${CONTACT.phoneDisplay} and we will quote you the current rate and tell you what is open today.`,
  },
  {
    question: 'What size unit do I need?',
    answer:
      'As a rough guide: a 5x10 holds a studio apartment, a 10x10 holds a one or two-bedroom, and a 10x20 holds a three or four-bedroom house. Our size guide walks through each one with what actually fits inside.',
  },
  {
    question: 'Do you serve Fort Oglethorpe and Chattanooga?',
    answer: `Yes. We are just off Cloud Springs Road, a short drive from Fort Oglethorpe and Rossville, and about a mile south of the Tennessee line — so East Ridge and south Chattanooga are close too.`,
  },
];
---

<BaseLayout title="Storage Units in Rossville, GA | Catoosa County Storage" description={SITE.description} faqs={faqs}>
  <!--
    ── Hero ────────────────────────────────────────────────────────────────
    Bright, not dark. The CLIMATE CLEAR direction is "bright even lighting,
    generous white space", so the page opens on white-to-ice with a CSS frost
    field rather than the dark slab the Cañon City site uses. The whole point
    of the brand is that it is the cool, dry, controlled option — a heavy dark
    hero would undercut that on first impression.
  -->
  <section class="frost-field relative overflow-hidden border-b border-brand-200/60">
    <div class="container-page relative py-16 sm:py-20 lg:py-24">
      <!--
        Two columns rather than a full-bleed photo. The source images top out at
        996px wide (see images.ts), so a full-width hero would render soft — and
        softer again on a 2x display. Constrained to roughly half the grid it
        stays sharp, and the frost field carries the width instead.
      -->
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="eyebrow">
            Rossville &middot; Fort Oglethorpe &middot; Catoosa County
          </p>
          <h1 class="mt-5 text-display font-semibold leading-[1.03]">
            Storage that holds its
            <span class="text-accent-700">temperature</span>.
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-ink-600 sm:text-xl">
            Climate-controlled units for the things that warp, rust and mildew in
            a Georgia summer — plus drive-up units for everything that does not.
            Both on one property off Cloud Springs Road.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/reserve" class="btn-primary">Check availability</a>
            <a href={CONTACT.phoneHref} class="btn-secondary">
              Call {CONTACT.phoneDisplay}
            </a>
          </div>

          <p class="mt-8 text-sm text-ink-600">
            {ADDRESS.formatted}
            {!HOURS.published && <> &middot; {HOURS.fallbackNote}</>}
          </p>
        </div>

        <Figure
          image={IMAGES.interiorClimateCorridor}
          sizes="(min-width: 1024px) 42rem, 100vw"
          ratio="4/3"
          priority
        />
      </div>
    </div>
  </section>

  <!-- ── The two products ──────────────────────────────────────────────── -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-headline font-bold">Two kinds of unit, one address</h2>
      <p class="mt-3 max-w-2xl text-lg text-ink-600">
        Most people need one of each eventually. You do not have to pick a second
        facility to get both.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article class="card !p-0 overflow-hidden">
          <Figure
            image={IMAGES.interiorClimateCorridorAlt}
            sizes="(min-width: 768px) 34rem, 100vw"
            ratio="16/9"
            class="[&>div]:rounded-none [&>div]:border-0 [&>div]:border-b [&>div]:border-brand-200/70"
          />
          <div class="p-6">
          <h3 class="text-xl font-bold">Climate controlled</h3>
          <p class="mt-3 leading-relaxed text-ink-600">
            Temperature and humidity controlled. Rossville sits in a humid
            subtropical climate — solid wood joints loosen, upholstery mildews,
            photographs stick together and electronics corrode in an
            uncontrolled space. This is the unit for anything you would not
            leave in a shed.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-ink-700">
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Wood and upholstered furniture
            </li>
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Electronics, instruments, vinyl
            </li>
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Photographs, documents, business records
            </li>
          </ul>
          <a
            href="/climate-controlled-storage"
            class="mt-6 inline-flex min-h-11 items-center font-semibold text-brand-700
                   underline decoration-2 underline-offset-4 hover:text-brand-800"
          >
            More on climate control
          </a>
          </div>
        </article>

        <article class="card !p-0 overflow-hidden">
          <Figure
            image={IMAGES.exteriorGreenDoors}
            sizes="(min-width: 768px) 34rem, 100vw"
            ratio="16/9"
            grade
            class="[&>div]:rounded-none [&>div]:border-0 [&>div]:border-b [&>div]:border-brand-200/70"
          />
          <div class="p-6">
          <h3 class="text-xl font-bold">Drive-up</h3>
          <p class="mt-3 leading-relaxed text-ink-600">
            Ground level, pull your car or trailer to the door and unload
            straight in. No hallway, no corners to get a sofa around. This is
            the cheaper unit and the right one for anything that tolerates
            ordinary outdoor temperatures.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-ink-700">
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Tools, yard and garage equipment
            </li>
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Patio furniture and seasonal gear
            </li>
            <li class="flex gap-2.5">
              <span class="text-accent-600" aria-hidden="true">&#10003;</span>
              Stock you load and unload often
            </li>
          </ul>
          <a
            href="/units"
            class="mt-6 inline-flex min-h-11 items-center font-semibold text-brand-700
                   underline decoration-2 underline-offset-4 hover:text-brand-800"
          >
            See sizes
          </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Sizes ─────────────────────────────────────────────────────────── -->
  <section class="bg-brand-50 py-16 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-headline font-bold">Unit sizes</h2>
          <p class="mt-3 max-w-2xl text-lg text-ink-600">
            Sized against rooms you already know, so you can picture it without a
            tape measure.
          </p>
        </div>
        <a href="/storage-unit-size-guide" class="btn-secondary !py-2.5 !text-sm">
          Full size guide
        </a>
      </div>

      <div class="mt-8">
        <ProvisionalNote when={CATALOGUE_PROVISIONAL}>
          These are typical self-storage sizes. We have not yet confirmed which of
          them this facility stocks, or in which type.
        </ProvisionalNote>
      </div>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          UNITS.map((u) => (
            <li>
              <a
                href={`/units#${u.slug}`}
                class="card block h-full hover:shadow-lg"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="text-2xl font-bold text-ink-900">{u.name}</h3>
                  <span class="text-sm text-ink-600">{u.sqft} sq ft</span>
                </div>
                <p class="mt-1 font-semibold text-brand-700">{u.comparableTo}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink-600">{u.fits}</p>
                <p class="mt-4 text-sm font-bold text-ink-900">
                  {u.priceFrom !== null
                    ? `From $${u.priceFrom}/mo`
                    : 'Call for pricing'}
                </p>
              </a>
            </li>
          ))
        }
      </ul>

      {
        !PRICING_AVAILABLE && (
          <p class="mt-6 text-sm text-ink-600">
            Rates depend on size and whether you want climate control.{' '}
            <a
              href={CONTACT.phoneHref}
              class="font-semibold text-brand-700 underline underline-offset-2"
            >
              Call {CONTACT.phoneDisplay}
            </a>{' '}
            for today's price and availability.
          </p>
        )
      }
    </div>
  </section>

  <!-- ── Why here ──────────────────────────────────────────────────────── -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-headline font-bold">Why store here</h2>
      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          FEATURES.map((f) => (
            <div class="border-l-2 border-accent-500 pl-5">
              <h3 class="text-lg font-bold">{f.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-600">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Location ──────────────────────────────────────────────────────── -->
  <section class="bg-brand-800 py-16 text-white sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-headline font-bold text-white">Finding us</h2>
          <p class="mt-4 text-lg leading-relaxed text-brand-100">
            {ADDRESS.accessNote}
          </p>
          <address class="mt-6 not-italic text-lg leading-relaxed">
            {ADDRESS.street}<br />
            {ADDRESS.city}, {ADDRESS.state} {ADDRESS.zip}
          </address>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/location" class="btn-on-dark !py-2.5 !text-sm">
              Directions
            </a>
            <a href={CONTACT.phoneHref} class="btn-primary !py-2.5 !text-sm">
              Call {CONTACT.phoneDisplay}
            </a>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-widest text-accent-400">
            Serving
          </h3>
          <ul class="mt-4 grid grid-cols-2 gap-y-2 text-brand-100">
            {
              SERVICE_AREA.map((area) => (
                <li class="flex items-center gap-2">
                  <span class="text-accent-400" aria-hidden="true">
                    &middot;
                  </span>
                  {area}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-brand-200">
            The Tennessee line is about a mile north, so storing on the Georgia
            side is a short drive from East Ridge and south Chattanooga.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="py-16 sm:py-20">
    <div class="container-page max-w-3xl">
      <h2 class="text-headline font-bold">Common questions</h2>
      <div class="mt-8">
        <FaqAccordion faqs={faqs} />
      </div>
      <p class="mt-6 text-sm text-ink-600">
        More on the <a href="/faq" class="font-semibold text-brand-700 underline underline-offset-2">FAQ page</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
