---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, NAV } from '../data/site';
---

<BaseLayout
  title="Page Not Found"
  description="That page could not be found. Try the links below, or call (706) 858-6498."
  noindex
>
  <section class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-brand-700">404</p>
      <h1 class="mt-3 text-headline font-bold">We could not find that page</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        The link may be out of date. Everything on the site is one of these:
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          [...NAV, { label: 'Check availability', href: '/reserve' }, { label: 'Contact', href: '/contact' }].map(
            (item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-11 items-center justify-center rounded-lg border border-ink-200 px-4 py-3 font-semibold text-ink-900 transition hover:border-ink-300 hover:bg-ink-50"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <p class="mt-10 text-ink-600">
        Or just call us:{' '}
        <a href={CONTACT.phoneHref} class="font-bold text-brand-700 hover:underline">
          {CONTACT.phoneDisplay}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
