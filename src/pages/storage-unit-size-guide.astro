---
/**
 * Storage unit size guide.
 *
 * The main organic play. "What size storage unit do I need" is the highest-volume
 * informational query in this category, and it converts because someone asking it
 * is already moving.
 *
 * Built off the same UNITS array as /units so the two pages can never disagree.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { Image } from 'astro:assets';
import { CONTACT } from '../data/site';
import { IMAGES } from '../data/images';
import {
  CLIMATE_UNITS,
  DRIVE_UP_UNITS,
  CONTAINERS,
  UNIT_TYPE_LABEL,
  formatPrice,
  RATE_TERMS,
} from '../data/units';

const crumbs = [
  { name: 'Storage Unit Size Guide', href: '/storage-unit-size-guide' },
];

const faqs = [
  {
    question: 'What size storage unit do I need?',
    answer:
      'Match it to the home you are emptying. A studio fits in a 5x10, a one or two-bedroom apartment in a 10x10, and a three or four-bedroom house in a 10x20. If you are between two sizes, take the larger one — you need aisle space to reach anything at the back.',
  },
  {
    question: 'Should I round up or down?',
    answer:
      'Up, nearly always. The cost difference between adjacent sizes is small next to the cost of hiring a van twice because the first unit did not close. It is also much easier to live with a unit you can walk into.',
  },
  {
    question: 'How high can I stack?',
    answer:
      'Units are taller than most people expect, so vertical space is where the capacity actually is. Heaviest and sturdiest at the bottom, nothing fragile load-bearing, and leave a gap at the top rather than wedging boxes against the ceiling.',
  },
  {
    question: 'Do I need a walkway down the middle?',
    answer:
      'If you will visit more than once, yes. Leave a corridor to the back wall and put anything seasonal near the door. A perfectly packed unit you cannot get into is a false economy.',
  },
];

const PACKING = [
  {
    title: 'Measure the big things, guess the rest',
    body: 'Sofa, mattress, fridge, washer, dryer, dining table. Those four or five items decide the size; boxes fill in around them.',
  },
  {
    title: 'Stack up, not out',
    body: 'Uniform boxes stack far better than mixed ones. Heavy on the bottom, light on top, nothing fragile bearing weight.',
  },
  {
    title: 'Dismantle what comes apart',
    body: 'Bed frames, table legs and shelving. Tape the fixings to the underside of the piece they came off so they are still there in a year.',
  },
  {
    title: 'Leave a path to the back',
    body: 'Especially if this is a long stay. Seasonal and frequently-needed items go nearest the door.',
  },
  {
    title: 'Lift furniture off the floor',
    body: 'Pallets or battens under anything wooden or upholstered. Costs nothing and keeps the base out of any moisture.',
  },
  {
    title: 'Cover, but let it breathe',
    body: 'Cotton sheets or moving blankets over furniture. Sealed plastic traps moisture against the surface, which is worse than leaving it uncovered.',
  },
];
---

<BaseLayout
  title="Climate-Controlled Unit Size Guide"
  description="What size climate-controlled storage unit you need in Rossville, GA, from a 5x10 to a 10x20, plus a sealed container. Catoosa County Storage."
  breadcrumbs={crumbs}
  faqs={faqs}
>
  <PageHeader
    eyebrow="Climate-controlled storage"
    title="What size climate-controlled unit do I need?"
    lede="Match the indoor unit to the home you are emptying, then go one size up if you are torn. These units are not drive-up."
    crumbs={crumbs}
  />

  <section class="container-page py-14 sm:py-20">
    <p class="max-w-3xl text-sm leading-relaxed text-ink-600">{RATE_TERMS}</p>

    <div class="mt-12 space-y-10">
      {
        CLIMATE_UNITS.map((u) => (
          <article id={u.slug} class="scroll-mt-28 border-t border-brand-200/70 pt-10">
            <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-12">
              <div>
                <h2 class="text-3xl font-semibold text-brand-800">{u.name}</h2>
                <p class="mt-1 text-sm text-ink-600">{u.sqft} sq ft</p>
                <p class="mt-3 font-medium text-accent-700">{u.comparableTo}</p>
                <p class="mt-3 text-sm font-semibold text-brand-800">
                  {formatPrice(u.price)}
                </p>
                <p class="mt-1 text-xs text-ink-600">{UNIT_TYPE_LABEL[u.kind]}</p>
              </div>

              <div>
                <p class="text-lg leading-relaxed text-ink-600">{u.fits}</p>
                <h3 class="mt-6 text-sm font-semibold uppercase tracking-wider text-brand-800">
                  Typically used for
                </h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {u.goodFor.map((g) => (
                    <li class="rounded-full bg-brand-100 px-3 py-1 text-sm text-brand-800">
                      {g}
                    </li>
                  ))}
                </ul>
                <a
                  href={`/reserve?size=${u.slug}`}
                  class="mt-5 inline-flex min-h-11 items-center font-semibold text-brand-700
                         underline decoration-2 underline-offset-4 hover:text-brand-800"
                >
                  Ask about this {u.name}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div id="8x20-container" class="mt-16 scroll-mt-28 border-t border-brand-200/70 pt-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">Premium option</p>
      <h2 class="mt-2 text-3xl font-semibold text-brand-800">Sealed storage container</h2>
      <p class="mt-3 text-sm font-semibold text-brand-800">{formatPrice(CONTAINERS[0].price)}</p>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">{CONTAINERS[0].fits}</p>
      <a
        href={`/reserve?size=${CONTAINERS[0].slug}`}
        class="mt-5 inline-flex min-h-11 items-center font-semibold text-brand-700 underline decoration-2 underline-offset-4"
      >
        Ask about this container
      </a>
    </div>

    <div class="mt-12 border-t border-brand-200/70 pt-8">
      <h2 class="text-xl font-semibold text-brand-800">Drive-up units</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-600">
        Not climate-controlled. The same three footprints, with pull-up access.
      </p>
      <ul class="mt-4 max-w-xl divide-y divide-brand-200/70">
        {
          DRIVE_UP_UNITS.map((u) => (
            <li class="flex items-baseline justify-between gap-4 py-3">
              <span class="font-semibold text-brand-800">{u.name} {UNIT_TYPE_LABEL[u.kind]}</span>
              <span class="text-sm font-bold">{formatPrice(u.price)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Decorative break between the size list and the packing advice. Purely
       visual: nothing is written over it, so it needs no scrim and carries
       empty alt text. -->
  <div class="relative h-40 overflow-hidden sm:h-52" aria-hidden="true">
    <Image
      src={IMAGES.textureFrostedGlass.src}
      alt=""
      widths={[768, 1280, 1344]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  </div>

  <section class="bg-brand-50 py-16 sm:py-20">
    <div class="container-page">
      <h2 class="text-headline font-semibold">Packing so it actually fits</h2>
      <p class="mt-3 max-w-2xl text-lg text-ink-600">
        Most people can drop a whole size by packing properly. These are the six
        things that make the difference.
      </p>
      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          PACKING.map((tip) => (
            <div class="border-l-2 border-accent-500 pl-5">
              <h3 class="font-semibold text-brand-800">{tip.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{tip.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="max-w-3xl">
      <h2 class="text-headline font-semibold">Common questions</h2>
      <div class="mt-8">
        <FaqAccordion faqs={faqs} />
      </div>
      <p class="mt-8 leading-relaxed text-ink-600">
        Still not sure? Describe what you are storing and we will tell you which size
        it lands in —{' '}
        <a
          href={CONTACT.phoneHref}
          class="font-semibold text-brand-700 underline underline-offset-2"
        >
          {CONTACT.phoneDisplay}
        </a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
