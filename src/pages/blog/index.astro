---
/**
 * Blog index. Posts are ordinary pages so the sitemap picks them up with
 * everything else. Add a card by adding a row in src/data/blog.ts and a page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { BLOG_POSTS, formatBlogDate } from '../../data/blog';

const crumbs = [{ name: 'Climate storage guides', href: '/blog' }];
---

<BaseLayout
  title="Climate-Controlled Storage Guides"
  description="Guides to indoor climate-controlled storage in Rossville, GA, including Georgia humidity and directions from Chattanooga to Mack Smith Road."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Climate-controlled storage"
    title="Climate-controlled storage guides"
    lede="What belongs in an indoor hallway unit in this humidity, and how to get to 132 Mack Smith Road from Chattanooga."
    crumbs={crumbs}
  />

  <section class="container-page py-14 sm:py-20">
    <ul class="grid gap-6">
      {
        BLOG_POSTS.map((post) => (
          <li class="card">
            <p class="text-sm text-ink-600">
              <time datetime={post.datePublished}>{formatBlogDate(post.datePublished)}</time>
            </p>
            <h2 class="mt-2 text-2xl font-semibold text-brand-800">
              <a href={post.href} class="underline decoration-2 underline-offset-4 hover:text-brand-900">
                {post.headline}
              </a>
            </h2>
            <p class="mt-3 max-w-3xl leading-relaxed text-ink-600">{post.description}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-3xl leading-relaxed text-ink-600">
      Rates for the indoor units are on
      <a href="/units" class="font-semibold text-brand-700 underline underline-offset-2">
        units and pricing
      </a>. To ask what is open, 
      <a href="/reserve" class="font-semibold text-brand-700 underline underline-offset-2">
        check availability
      </a>.
    </p>
  </section>

  <CtaBand />
</BaseLayout>
