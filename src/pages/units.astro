---
/**
 * Units & pricing.
 *
 * A real <table> on desktop, cards on mobile — the same pattern that worked on the
 * Cañon City build. A table is the correct semantics for this data and it is what
 * screen readers and search engines both want; the card view is the same data
 * re-laid-out, not a second source.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Figure from '../components/Figure.astro';
import ReviewBand from '../components/ReviewBand.astro';
import { CONTACT } from '../data/site';
import { IMAGES } from '../data/images';
import {
  CLIMATE_UNITS,
  DRIVE_UP_UNITS,
  CONTAINERS,
  UNIT_TYPE_LABEL,
  formatPrice,
  PRICING_AVAILABLE,
  RATE_TERMS,
} from '../data/units';

const crumbs = [{ name: 'Units & Pricing', href: '/units' }];
---

<BaseLayout
  title="Climate-Controlled Storage Sizes & Rates"
  description="Climate-controlled storage sizes and rates in Rossville, GA. Indoor 5x10, 10x10 and 10x20 units, plus a sealed container at $100 a month. Call (706) 858-6498."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="Climate-controlled storage"
    title="Climate-controlled sizes and rates"
    lede="Indoor units: you walk in a door and the units are along a hallway. They are not drive-up. A sealed container is the premium option alongside them."
    crumbs={crumbs}
  />

  <section class="container-page py-14 sm:py-20">
    {
      PRICING_AVAILABLE ? (
        <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-600">{RATE_TERMS}</p>
      ) : (
        <p class="mt-6 max-w-2xl leading-relaxed text-ink-600">
          Rates change with size, unit type and what is open, so rather than post a
          number that might be out of date we would rather quote you the real one.
          <a
            href={CONTACT.phoneHref}
            class="ml-1 font-semibold text-brand-700 underline underline-offset-2"
          >
            Call {CONTACT.phoneDisplay}
          </a>{' '}
          or{' '}
          <a
            href="/reserve"
            class="font-semibold text-brand-700 underline underline-offset-2"
          >
            send us what you need
          </a>{' '}
          and we will come back with today's price.
        </p>
      )
    }

    <h2 class="mt-10 text-headline font-semibold">Indoor climate-controlled units</h2>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink-600">
      You walk in a door and the units are along a hallway. These are not drive-up.
    </p>

    <!-- Desktop: real table. -->
    <div class="mt-8 hidden overflow-x-auto md:block">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">
          Indoor climate-controlled storage sizes and monthly rates
        </caption>
        <thead>
          <tr class="border-b-2 border-brand-800">
            <th scope="col" class="py-3 pr-4 text-sm font-semibold text-brand-800">Size</th>
            <th scope="col" class="py-3 pr-4 text-sm font-semibold text-brand-800">Area</th>
            <th scope="col" class="py-3 pr-4 text-sm font-semibold text-brand-800">About the size of</th>
            <th scope="col" class="py-3 pr-4 text-sm font-semibold text-brand-800">What fits</th>
            <th scope="col" class="py-3 pr-4 text-sm font-semibold text-brand-800">Type</th>
            <th scope="col" class="py-3 text-sm font-semibold text-brand-800">Price</th>
          </tr>
        </thead>
        <tbody>
          {
            CLIMATE_UNITS.map((u) => (
              <tr id={u.slug} class="border-b border-brand-200/70 align-top scroll-mt-28">
                <th scope="row" class="py-5 pr-4 text-lg font-semibold text-brand-800">
                  {u.name}
                </th>
                <td class="py-5 pr-4 text-sm text-ink-600">{u.sqft} sq ft</td>
                <td class="py-5 pr-4 text-sm font-medium text-accent-700">{u.comparableTo}</td>
                <td class="max-w-sm py-5 pr-4 text-sm leading-relaxed text-ink-600">{u.fits}</td>
                <td class="py-5 pr-4 text-sm text-ink-600">{UNIT_TYPE_LABEL[u.kind]}</td>
                <td class="whitespace-nowrap py-5 text-sm font-semibold text-brand-800">
                  {formatPrice(u.price)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Mobile: same data as cards. -->
    <ul class="mt-10 grid gap-4 md:hidden">
      {
        CLIMATE_UNITS.map((u) => (
          <li id={`${u.slug}-m`} class="card scroll-mt-28">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-2xl font-semibold text-brand-800">{u.name}</h2>
              <span class="text-sm text-ink-600">{u.sqft} sq ft</span>
            </div>
            <p class="mt-1 text-sm text-ink-600">{UNIT_TYPE_LABEL[u.kind]}</p>
            <p class="mt-1 font-medium text-accent-700">{u.comparableTo}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{u.fits}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {u.goodFor.map((g) => (
                <li class="rounded-full bg-brand-100 px-3 py-1 text-xs font-medium text-brand-800">
                  {g}
                </li>
              ))}
            </ul>
            <div class="mt-4 flex items-center justify-between gap-3 border-t border-brand-200/70 pt-4">
              <span class="text-sm font-semibold text-brand-800">
                {formatPrice(u.price)}
              </span>
              <a
                href={`/reserve?size=${u.slug}`}
                class="text-sm font-semibold text-accent-700 underline underline-offset-4"
              >
                Ask about this size
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div id="8x20-container" class="card mt-14 scroll-mt-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">Premium option</p>
      <h2 class="mt-2 text-headline font-semibold">Sealed storage containers</h2>
      <p class="mt-3 text-3xl font-bold text-brand-800">{formatPrice(CONTAINERS[0].price)}</p>
      <p class="mt-3 max-w-2xl leading-relaxed text-ink-600">{CONTAINERS[0].fits}</p>
      <p class="mt-4 text-sm text-ink-600">{RATE_TERMS}</p>
      <a
        href={`/reserve?size=${CONTAINERS[0].slug}`}
        class="mt-5 inline-flex min-h-11 items-center font-semibold text-brand-700 underline decoration-2 underline-offset-4"
      >
        Ask about this container
      </a>
    </div>

    <div class="mt-14 border-t border-brand-200/70 pt-8">
      <h2 class="text-xl font-semibold">Drive-up units</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-600">
        Not climate-controlled. Exactly three sizes, with pull-up access.
      </p>
      <div class="mt-6 hidden overflow-x-auto md:block">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">Drive-up storage sizes and monthly rates. Not climate-controlled.</caption>
          <thead>
            <tr class="border-b border-brand-200">
              <th scope="col" class="py-2 pr-4 font-semibold text-brand-800">Size</th>
              <th scope="col" class="py-2 pr-4 font-semibold text-brand-800">Area</th>
              <th scope="col" class="py-2 pr-4 font-semibold text-brand-800">Type</th>
              <th scope="col" class="py-2 font-semibold text-brand-800">Price</th>
            </tr>
          </thead>
          <tbody>
            {
              DRIVE_UP_UNITS.map((u) => (
                <tr id={u.slug} class="border-b border-brand-200/70 scroll-mt-28">
                  <th scope="row" class="py-3 pr-4 font-semibold text-brand-800">{u.name}</th>
                  <td class="py-3 pr-4 text-ink-600">{u.sqft} sq ft</td>
                  <td class="py-3 pr-4 text-ink-600">{UNIT_TYPE_LABEL[u.kind]}</td>
                  <td class="py-3 font-semibold text-brand-800">{formatPrice(u.price)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ul class="mt-4 divide-y divide-brand-200/70 md:hidden">
        {
          DRIVE_UP_UNITS.map((u) => (
            <li id={`${u.slug}-m`} class="flex items-baseline justify-between gap-4 py-3 scroll-mt-28">
              <span>
                <span class="font-semibold text-brand-800">{u.name}</span>
                <span class="mt-0.5 block text-sm text-ink-600">{UNIT_TYPE_LABEL[u.kind]}</span>
              </span>
              <span class="text-sm font-semibold text-brand-800">{formatPrice(u.price)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 grid items-center gap-8 rounded-card bg-brand-50 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div>
      <h2 class="text-xl font-semibold">Not sure which one?</h2>
      <p class="mt-2 max-w-2xl leading-relaxed text-ink-600">
        The most common mistake is renting one size too small and then paying to move
        twice. Our size guide walks through each unit with what actually fits, and if
        you are between two sizes we will talk it through on the phone.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/storage-unit-size-guide" class="btn-secondary !py-2.5 !text-sm">
          Read the size guide
        </a>
        <a href={CONTACT.phoneHref} class="btn-primary !py-2.5 !text-sm">
          Call {CONTACT.phoneDisplay}
        </a>
      </div>
      </div>
      <Figure
        image={IMAGES.exteriorDriveAisle}
        sizes="(min-width: 1024px) 22rem, 100vw"
        ratio="4/3"
        grade
      />
    </div>
  </section>

  <ReviewBand compact />

  <CtaBand />
</BaseLayout>
