---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT, HOURS, ADDRESS } from '../../data/site';
---

<BaseLayout
  title="Request Received"
  description="Thank you — your storage request has been received."
  noindex
>
  <section class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-xl text-center">
      <svg viewBox="0 0 24 24" fill="none" class="mx-auto h-16 w-16 text-brand-600" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"></circle>
        <path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      <h1 class="mt-6 text-headline font-bold">Request received</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        Thanks — we have your details. We will confirm availability and current
        pricing as soon as we can, during office hours.
      </p>

      <div class="mt-10 rounded-card border border-ink-200 p-6 text-left">
        <h2 class="font-bold text-ink-900">Need an answer sooner?</h2>
        <a href={CONTACT.phoneHref} class="mt-2 block text-2xl font-bold text-brand-700 hover:underline">
          {CONTACT.phoneDisplay}
        </a>
        {
          HOURS.published && HOURS.office ? (
            <dl class="mt-3 space-y-1 text-sm">
              {HOURS.office.days.map((d) => (
                <div class="flex justify-between gap-3">
                  <dt class="text-ink-600">{d.day}</dt>
                  <dd class="font-medium text-brand-800">{d.hours}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="mt-3 text-sm text-ink-600">{HOURS.fallbackNote}.</p>
          )
        }
      </div>

      <div class="mt-6 rounded-card border border-ink-200 p-6 text-left">
        <h2 class="font-bold text-brand-800">Finding us the first time</h2>
        <p class="mt-1 text-sm text-ink-600">{ADDRESS.accessNote}</p>
        <address class="mt-3 not-italic text-ink-700">
          {ADDRESS.street}, {ADDRESS.city}, {ADDRESS.state} {ADDRESS.zip}
        </address>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/location" class="btn-secondary">Directions &amp; map</a>
        <a href="/storage-unit-size-guide" class="btn-secondary">Size guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
