---
/**
 * Visible breadcrumb trail. The matching BreadcrumbList schema is emitted
 * separately by BaseLayout — pass the same array to both so they never diverge.
 */
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
  /** Render light-on-dark, for use inside a dark page header. */
  onDark?: boolean;
}

const { crumbs, onDark = false } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class:list={['flex flex-wrap items-center gap-1.5 text-sm', onDark ? 'text-ink-300' : 'text-ink-600']}>
    <li>
      <a
        href="/"
        class:list={['rounded transition hover:underline', onDark ? 'hover:text-white' : 'hover:text-ink-900']}
      >
        Home
      </a>
    </li>
    {
      crumbs.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          <!-- ink-400 on brand-900 is 5.79:1; ink-500 measured 3.30:1 and failed.
               On white the separator needs the darker end instead. -->
          <span aria-hidden="true" class={onDark ? 'text-ink-400' : 'text-ink-600'}>
            /
          </span>
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class={onDark ? 'text-white' : 'text-ink-900'}>
              {crumb.name}
            </span>
          ) : (
            <a
              href={crumb.href}
              class:list={['rounded transition hover:underline', onDark ? 'hover:text-white' : 'hover:text-ink-900']}
            >
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
