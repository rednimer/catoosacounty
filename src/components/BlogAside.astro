---
/**
 * Shared rail for blog posts: phone, reserve, address, pricing.
 * NAP comes from the data layer so it cannot drift from the footer.
 */
import { CONTACT, ADDRESS } from '../data/site';
---

<aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
  <div class="card">
    <h2 class="font-semibold text-brand-800">Ask what is open</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink-600">
      Climate-controlled sizes sell through. Call or send a request and we will
      tell you what is actually available.
    </p>
    <a
      href={CONTACT.phoneHref}
      class="mt-4 block text-2xl font-semibold text-brand-800 hover:underline"
    >
      {CONTACT.phoneDisplay}
    </a>
    <a href="/reserve" class="btn-primary mt-4 !w-full !py-2.5 !text-sm">
      Check availability
    </a>
  </div>

  <div class="card">
    <h2 class="font-semibold text-brand-800">Monthly rates</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink-600">
      Indoor climate-controlled sizes and the sealed container are listed with
      current rates.
    </p>
    <a
      href="/units"
      class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-brand-700 underline underline-offset-4"
    >
      Units and pricing
    </a>
  </div>

  <div class="card">
    <h2 class="font-semibold text-brand-800">Where we are</h2>
    <address class="mt-2 not-italic leading-relaxed text-ink-600">
      {ADDRESS.street}<br />
      {ADDRESS.city}, {ADDRESS.state} {ADDRESS.zip}
    </address>
    <p class="mt-3 text-sm leading-relaxed text-ink-600">{ADDRESS.accessNote}</p>
    <a
      href="/location"
      class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-brand-700 underline underline-offset-4"
    >
      Directions
    </a>
  </div>
</aside>
