---
/**
 * Sticky site header. The phone number is the primary desktop CTA — storage is
 * a call-driven purchase. Mobile gets the dedicated call bar instead, so the
 * number is hidden here below `sm` to keep the bar from being redundant.
 *
 * The mobile menu uses <details>, so it works with zero JavaScript.
 *
 * Structurally this differs from the Cañon City header by design: a deep navy
 * utility strip sits above the main bar carrying the address and phone. It gives
 * the page a heavier top edge, puts the NAP above the fold on every page (a local
 * SEO and trust win), and makes the two sites read as different brands.
 * The strip is hidden on mobile, where the sticky call bar already covers it.
 */
import { CONTACT, ADDRESS, NAV } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!-- Utility strip. brand-800 (#0e3a5c) with white text is 11.74:1. -->
<div class="hidden bg-brand-800 text-white sm:block">
  <div class="container-page">
    <div class="flex h-9 items-center justify-between gap-4 text-xs">
      <p class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
          <path
            d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2"></circle>
        </svg>
        {ADDRESS.formatted}
      </p>
      <p class="hidden items-center gap-2 md:flex">
        <span class="text-brand-200">Climate controlled &amp; drive-up units</span>
      </p>
    </div>
  </div>
</div>

<header
  class="sticky top-0 z-40 border-b border-ink-200 bg-white/95 backdrop-blur
         supports-[backdrop-filter]:bg-white/80"
>
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      <!--
        No aria-label here. An aria-label REPLACES the accessible name, so the
        visible words would stop being part of it — which fails WCAG 2.5.3 (Label
        in Name) and breaks voice control: saying "click Catoosa County" would not
        match. The visible text is the accessible name, with a screen-reader-only
        suffix for context.
      -->
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 rounded-sm focus-visible:outline-2
               focus-visible:outline-offset-4 focus-visible:outline-brand-700"
      >
        <span
          class="grid h-9 w-9 place-items-center rounded-sm bg-brand-700 text-white
                 lg:h-10 lg:w-10"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 lg:h-6 lg:w-6">
            <path
              d="M3 9.5 12 4l9 5.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
            <path d="M8 21v-6h8v6" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-bold text-ink-900 lg:text-base">
            Catoosa County
          </span>
          <span
            class="block text-[0.7rem] font-semibold uppercase tracking-[0.18em]
                   text-brand-700 lg:text-xs"
          >
            Storage
          </span>
        </span>
        <span class="sr-only">— home</span>
      </a>

      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-sm px-3 py-2 text-sm font-medium transition',
                    isActive(item.href)
                      ? 'bg-brand-50 text-brand-800'
                      : 'text-ink-700 hover:bg-ink-50 hover:text-ink-900',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={CONTACT.phoneHref}
          class="hidden items-center gap-2 text-sm font-bold text-ink-900
                 transition hover:text-brand-700 sm:inline-flex"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path
              d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1
                 A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
          {CONTACT.phoneDisplay}
        </a>

        <!-- min-h-11 = 44px, the minimum comfortable touch target. -->
        <a href="/reserve" class="btn-primary min-h-11 !px-4 !py-2.5 !text-sm">
          Check availability
        </a>

        <details class="relative lg:hidden [&[open]_.i-open]:hidden [&[open]_.i-close]:block">
          <summary
            class="grid h-11 w-11 cursor-pointer place-items-center rounded-sm
                   border border-ink-200 text-ink-900 marker:content-none
                   [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="i-open h-5 w-5" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" class="i-close hidden h-5 w-5" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
          </summary>

          <nav
            aria-label="Mobile"
            class="absolute right-0 top-12 w-64 rounded-sm border border-ink-200
                   bg-white p-2 shadow-xl"
          >
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'flex min-h-11 items-center rounded-sm px-3 text-sm font-medium transition',
                        isActive(item.href)
                          ? 'bg-brand-50 text-brand-800'
                          : 'text-ink-700 hover:bg-ink-50',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li class="mt-1 border-t border-ink-200 pt-1">
                <a
                  href="/contact"
                  class="flex min-h-11 items-center rounded-sm px-3 text-sm
                         font-medium text-ink-700 transition hover:bg-ink-50"
                >
                  Contact
                </a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
