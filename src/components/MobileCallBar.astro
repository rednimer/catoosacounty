---
/**
 * Sticky bottom call/reserve bar, mobile only.
 *
 * Calling is the dominant conversion action for local storage on a phone, so it
 * gets permanent screen real estate. The <body> reserves matching bottom padding
 * (see global.css) so this never covers page content.
 */
import { CONTACT } from '../data/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-200 bg-white/95
         backdrop-blur lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <div class="grid grid-cols-2 gap-2 p-2">
    <a
      href={CONTACT.phoneHref}
      class="inline-flex items-center justify-center gap-2 rounded-sm bg-brand-700
             px-4 py-3 text-sm font-bold text-white transition active:bg-brand-800"
      data-analytics="call-bar-phone"
    >
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
        <path
          d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1
             A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      Call now
    </a>

    <a
      href="/reserve"
      class="inline-flex items-center justify-center gap-2 rounded-sm border-2
             border-ink-900 px-4 py-3 text-sm font-bold text-ink-900 transition
             active:bg-ink-900 active:text-white"
      data-analytics="call-bar-reserve"
    >
      Check availability
    </a>
  </div>
</div>

<!-- Spacer: keeps the fixed bar from covering the end of the page. -->
<div class="h-[4.5rem] lg:hidden" aria-hidden="true"></div>
