---
/**
 * Google rating and real customer reviews.
 *
 * The strongest element here is not the quote — it is the link. "4.5 from 21
 * reviews on Google", where the number is a link straight to the listing, is
 * checkable in one click. An unverifiable wall of five-star quotes is what the
 * May 2026 build did, and it is the pattern every visitor has learned to
 * discount.
 *
 * Renders the rating on its own if no review text has been cleared for use, so
 * the section still earns its place while REVIEWS is thin.
 *
 * The stars are decorative: the rating is stated in text right beside them, so
 * they carry aria-hidden and add nothing for a screen reader.
 */
import { GOOGLE_LISTING, REVIEWS, HAS_REVIEWS } from '../data/reviews';

interface Props {
  /** Tighter treatment for use inside a page rather than as a full band. */
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className = '' } = Astro.props;

const full = Math.floor(GOOGLE_LISTING.rating);
const half = GOOGLE_LISTING.rating % 1 >= 0.25;
---

<section
  class:list={[
    'border-y border-brand-200/70 bg-brand-50',
    compact ? 'py-10' : 'py-14 sm:py-16',
    className,
  ]}
  aria-labelledby="reviews-heading"
>
  <div class="container-page">
    <div class="flex flex-col items-center gap-3 text-center">
      <h2 id="reviews-heading" class="eyebrow">What customers say</h2>

      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <span class="flex items-center gap-0.5" aria-hidden="true">
          {
            Array.from({ length: 5 }, (_, i) => (
              <svg
                viewBox="0 0 20 20"
                class:list={[
                  'h-6 w-6',
                  i < full || (i === full && half) ? 'text-accent-500' : 'text-brand-200',
                ]}
                fill="currentColor"
              >
                {i === full && half ? (
                  <>
                    <defs>
                      <linearGradient id="half-star">
                        <stop offset="50%" stop-color="currentColor" />
                        <stop offset="50%" stop-color="#cfe2ee" />
                      </linearGradient>
                    </defs>
                    <path
                      fill="url(#half-star)"
                      d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z"
                    />
                  </>
                ) : (
                  <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                )}
              </svg>
            ))
          }
        </span>
        <span class="text-lg font-semibold text-brand-800">
          {GOOGLE_LISTING.rating} out of 5
        </span>
        <span class="text-ink-600">
          from{' '}
          <a
            href={GOOGLE_LISTING.url}
            rel="noopener nofollow"
            class="font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-800"
          >
            {GOOGLE_LISTING.reviewCount} reviews on Google
          </a>
        </span>
      </p>
    </div>

    {
      HAS_REVIEWS && (
        <ul
          class:list={[
            'mx-auto mt-10 grid gap-6',
            REVIEWS.length === 1 ? 'max-w-2xl' : 'md:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {REVIEWS.map((r) => (
            <li class="rounded-card border border-brand-200/70 bg-white p-6 shadow-[0_1px_2px_rgba(14,58,92,0.04)]">
              <blockquote class="text-lg leading-relaxed text-ink-700">
                <p>“{r.quote}”</p>
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-2 text-sm">
                <span class="font-semibold text-brand-800">{r.author}</span>
                <span class="text-ink-600">
                  · {r.source}, {r.posted}
                </span>
              </figcaption>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
