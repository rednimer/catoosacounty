{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build && node scripts/audit-form.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.catoosacountystorage.com"
        }
      ],
      "destination": "https://catoosacountystorage.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.catoosacountystorage.com"
        }
      ],
      "destination": "https://catoosacountystorage.com/:path+",
      "permanent": true
    },
    {
      "source": "/index.php/making-a-payment",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/index.php/directions-and-contact",
      "destination": "/location",
      "permanent": true
    },
    {
      "source": "/index.php/reserve-a-unit",
      "destination": "/reserve",
      "permanent": true
    },
    {
      "source": "/index.php/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/unit-sizes",
      "destination": "/units",
      "permanent": true
    },
    {
      "source": "/pages/climate-controlled-storage",
      "destination": "/climate-controlled-storage",
      "permanent": true
    },
    {
      "source": "/pages/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/reserve",
      "destination": "/reserve",
      "permanent": true
    },
    {
      "source": "/pages/pay-online",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
