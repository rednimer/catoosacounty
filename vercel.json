{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build && node scripts/audit-form.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/index\\.php/directions-and-contact/?$",
      "status": 308,
      "headers": { "Location": "/location" }
    },
    {
      "src": "^/index\\.php/making-a-payment/?$",
      "status": 308,
      "headers": { "Location": "/contact" }
    },
    {
      "src": "^/index\\.php/reserve-a-unit/?$",
      "status": 308,
      "headers": { "Location": "/reserve" }
    },
    {
      "src": "^/index\\.php/?$",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/(?:gone/?|[^/]+/[0-9]+/?|index\\.php/.+)$",
      "status": 410,
      "dest": "/gone.html",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "X-Robots-Tag": "noindex",
        "Cache-Control": "public, max-age=86400",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      }
    },
    {
      "src": "^/(.*)/$",
      "status": 308,
      "headers": { "Location": "/$1" }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.catoosacountystorage.com"
        }
      ],
      "destination": "https://catoosacountystorage.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.catoosacountystorage.com"
        }
      ],
      "destination": "https://catoosacountystorage.com/:path+",
      "permanent": true
    },
    {
      "source": "/pages/unit-sizes",
      "destination": "/units",
      "permanent": true
    },
    {
      "source": "/pages/climate-controlled-storage",
      "destination": "/climate-controlled-storage",
      "permanent": true
    },
    {
      "source": "/pages/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/reserve",
      "destination": "/reserve",
      "permanent": true
    },
    {
      "source": "/pages/pay-online",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
